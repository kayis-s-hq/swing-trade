#!/bin/bash
echo "---- Pre-Commit Hooks ----"

# Get staged files
staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
    echo "No staged files — skipping pre-commit checks."
    exit 0
fi

# Check if any Java/module files are involved
java_files=()
gradle_files=()
for f in $staged_files; do
    if [[ "$f" == *.java ]]; then
        java_files+=("$f")
    elif [[ "$f" == backend/gradle* ]] || [[ "$f" == */build.gradle.kts ]]; then
        gradle_files+=("$f")
    fi
done

# Check if any frontend files are involved
vue_files=()
ts_files=()
for f in $staged_files; do
    if [[ "$f" == *.vue ]]; then
        vue_files+=("$f")
    elif [[ "$f" == *.ts ]]; then
        ts_files+=("$f")
    fi
done

# Determine which backend modules have changes
modules_to_check=()
for f in "${java_files[@]}" "${gradle_files[@]}"; do
    if [[ "$f" == backend/core/* ]]; then
        modules_to_check+=("core")
    elif [[ "$f" == backend/data/* ]]; then
        modules_to_check+=("data")
    elif [[ "$f" == backend/strategy/* ]]; then
        modules_to_check+=("strategy")
    elif [[ "$f" == backend/llm/* ]]; then
        modules_to_check+=("llm")
    elif [[ "$f" == backend/broker/* ]]; then
        modules_to_check+=("broker")
    elif [[ "$f" == backend/api/* ]]; then
        modules_to_check+=("api")
    elif [[ "$f" == "backend/build.gradle.kts" ]] || [[ "$f" == "backend/settings.gradle.kts" ]]; then
        modules_to_check=("core" "data" "strategy" "llm" "broker" "api")
        break
    fi
done

if [ ${#java_files[@]} -gt 0 ] || [ ${#gradle_files[@]} -gt 0 ]; then
    if [ ${#modules_to_check[@]} -eq 0 ]; then
        echo "No backend module changes — skipping backend checks."
    else
        modules_to_check=($(printf '%s\n' "${modules_to_check[@]}" | sort -u))
        echo "Modules with changes: ${modules_to_check[*]}"

        source "$HOME/.sdkman/bin/sdkman-init.sh"

        echo "Running checkstyle on: ${modules_to_check[*]}"
        module_args=""
        for m in "${modules_to_check[@]}"; do
            module_args="$module_args :$m:checkstyleMain :$m:checkstyleTest"
        done
        cd backend
        ../gradlew $module_args -B -x test
        checkstyle_exit=$?

        if [ $checkstyle_exit -ne 0 ]; then
            echo "ERROR: checkstyle failed. Fix violations before committing."
            exit 1
        fi
    fi
fi

# ---- Frontend: Prettier format check ----
if [ ${#vue_files[@]} -gt 0 ] || [ ${#ts_files[@]} -gt 0 ]; then
    echo "Running Prettier format check on frontend..."
    cd dashboard

    frontend_files=""
    for f in "${vue_files[@]}" "${ts_files[@]}"; do
        stripped="${f#dashboard/}"
        frontend_files="$frontend_files $stripped"
    done

    npx prettier --check $frontend_files 2>&1
    prettier_exit=$?

    if [ $prettier_exit -ne 0 ]; then
        echo "ERROR: Prettier formatting violations found. Run 'yarn format:write' to fix."
        exit 1
    fi

    echo "Prettier check passed."
fi

# ---- Frontend: TypeScript typecheck ----
if [ ${#vue_files[@]} -gt 0 ] || [ ${#ts_files[@]} -gt 0 ]; then
    echo "Running TypeScript typecheck..."
    cd dashboard

    yarn typecheck 2>&1
    typecheck_exit=$?

    if [ $typecheck_exit -ne 0 ]; then
        echo "ERROR: TypeScript typecheck failed. Fix type errors before committing."
        exit 1
    fi

    echo "Typecheck passed."
fi

# ---- Frontend: ESLint on staged Vue/TS files ----
if [ ${#vue_files[@]} -gt 0 ] || [ ${#ts_files[@]} -gt 0 ]; then
    echo "Running ESLint on staged frontend files..."
    cd dashboard

    frontend_files=""
    for f in "${vue_files[@]}" "${ts_files[@]}"; do
        stripped="${f#dashboard/}"
        frontend_files="$frontend_files $stripped"
    done

    npx eslint --fix --no-warn-ignored --quiet $frontend_files 2>&1
    eslint_exit=$?

    if [ $eslint_exit -ne 0 ]; then
        echo "ERROR: ESLint found errors (not warnings). Fix before committing."
        exit 1
    fi

    git add dashboard/$frontend_files

    echo "ESLint passed."
fi

# ---- Structural checks: enforce project organization ----
echo "Running structural checks..."

check_structure() {
    local error=0

    # No JAR files in backend root
    for f in backend/*.jar; do
        if [ -e "$f" ]; then
            echo "ERROR: $f should be in libs/ or removed (build artifact)"
            error=1
        fi
    done

    # No env files in backend
    for f in backend/.env*; do
        if [ -e "$f" ]; then
            echo "ERROR: $f should be in infra/env/"
            error=1
        fi
    done

    # No docker-compose files in backend
    for f in backend/docker-compose*.yml; do
        if [ -e "$f" ]; then
            echo "ERROR: $f should be in infra/"
            error=1
        fi
    done

    # No backend Dockerfile
    if [ -f backend/Dockerfile ]; then
        echo "ERROR: backend/Dockerfile should be in infra/"
        error=1
    fi

    # No deploy.sh in backend
    if [ -f backend/deploy.sh ]; then
        echo "ERROR: backend/deploy.sh should be in infra/"
        error=1
    fi

    # No nginx configs in backend
    if [ -d backend/reports-nginx ]; then
        echo "ERROR: backend/reports-nginx/ should be in infra/nginx/"
        error=1
    fi

    # No monitoring in backend
    if [ -d backend/monitoring ]; then
        echo "ERROR: backend/monitoring/ should be in infra/monitoring/"
        error=1
    fi

    # No logs in backend
    if [ -d backend/logs ]; then
        echo "ERROR: backend/logs/ should not exist (runtime artifact)"
        error=1
    fi

    # No test-results in backend root or api/
    if [ -d backend/test-results ]; then
        echo "ERROR: backend/test-results/ should not exist (Gradle build output)"
        error=1
    fi
    if [ -d backend/api/test-results ]; then
        echo "ERROR: backend/api/test-results/ should not exist (Gradle build output)"
        error=1
    fi

    # No libs in data module
    if [ -d backend/data/libs ]; then
        echo "ERROR: backend/data/libs/ removed; use libs/ for shared JARs"
        error=1
    fi

    # No config symlink in api
    if [ -d backend/api/config ]; then
        echo "ERROR: backend/api/config/ removed; use backend/config/ for shared config"
        error=1
    fi

    # No nested dashboard
    if [ -d dashboard/dashboard ]; then
        echo "ERROR: dashboard/dashboard/ is a leftover artifact"
        error=1
    fi

    # No Dockerfile or nginx.conf in dashboard
    for f in dashboard/Dockerfile dashboard/nginx.conf; do
        if [ -e "$f" ]; then
            echo "ERROR: $f should be in infra/"
            error=1
        fi
    done

    # No build output in dashboard
    for d in dashboard/dist dashboard/logs dashboard/test-results; do
        if [ -d "$d" ]; then
            echo "ERROR: $d should not exist in source tree"
            error=1
        fi
    done

    # Issue files must be in docs/issues/
    for f in .github/issues/*.md; do
        if [ -e "$f" ]; then
            echo "ERROR: $f should be in docs/issues/"
            error=1
        fi
    done

    # docs/plan/ merged into docs/plans/
    if [ -d docs/plan ]; then
        echo "ERROR: docs/plan/ merged into docs/plans/"
        error=1
    fi

    if [ $error -ne 0 ]; then
        echo "FAILED: structural checks failed. Fix the issues above."
        return 1
    fi

    echo "Structural checks passed."
    return 0
}

check_structure
struct_exit=$?
if [ $struct_exit -ne 0 ]; then
    exit 1
fi

exit 0
