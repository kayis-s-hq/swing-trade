# ==============================================================================
# SwingTrade API - Native Image Dockerfile
# ==============================================================================
# Build native image locally on macOS (requires GraalVM JDK 21),
# then copy the binary into a minimal Alpine runtime image.
#
# Usage:
#   1. Build native image: ./gradlew :api:nativeCompile
#   2. Build Docker image: docker build -t swing-trade-api:native -f infra/Dockerfile.native .
#   3. Run: docker run -p 8080:8080 swing-trade-api:native
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: runtime - Minimal runtime for native binary
# ------------------------------------------------------------------------------
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Copy the native binary from build output
COPY backend/api/build/native/nativeCompile/api /app/swing-trade-api

# Expose API port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD ["/app/swing-trade-api", "actuator", "health"] || exit 1

# Run the native binary with Spring profiles
ENTRYPOINT ["/app/swing-trade-api"]
CMD ["--spring.profiles.active=${SPRING_PROFILES_ACTIVE:-stage}", "--server.port=${SERVER_PORT:-8080}"]