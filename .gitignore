# Environment files
# .env - Production secrets (never commit)
# .env.local - Local overrides (never commit)
# .env.dev - Development credentials (contains sandbox keys, do not commit)
# .env.example - Reference template (always commit)
# .env.dev.example - Development reference template (always commit)
.env
.env.local
.env.*.local
.env.dev

# Environment files with real credentials (add .example versions for reference)
.env.*.real
.env.*.prod

# Database files (if any local DBs)
*.db
*.sqlite
*.h2.db

# Database backups
backups/

# Local configuration
local.properties
user.properties

