<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="com.puppycrawl.tools.checkstyle.Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <module name="BeforeExecutionExclusionFileFilter">
    <property name="fileNamePattern" value="module\-info\.java$"/>
  </module>
  <module name="TreeWalker">
    <module name="ClassTypeParameterName"/>
    <module name="MethodTypeParameterName"/>
    <module name="InterfaceTypeParameterName"/>
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="ParameterName"/>
    <module name="LocalFinalVariableName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <!-- Default pattern (^[a-z][a-zA-Z0-9]*$) rejects underscores. Every violation of
         the default is in test code using this codebase's established
         methodUnderTest_condition_expectedResult convention (806 occurrences, zero
         in production code) - this permits that convention instead of renaming it. -->
    <module name="MethodName">
      <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
    </module>
    <module name="TypeName"/>
    <module name="AvoidStarImport"/>
    <module name="IllegalImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>
    <module name="IllegalTokenText"/>
    <module name="ModifierOrder"/>
    <module name="OneStatementPerLine"/>
    <module name="UnnecessaryParentheses"/>
    <module name="HideUtilityClassConstructor"/>
    <module name="InnerTypeLast"/>
    <module name="InterfaceIsType"/>
    <!-- protectedAllowed: this codebase's abstract test base classes (e.g.
         BaseWebMvcTest, ApiIntegrationTest) deliberately expose protected fields
         for subclass test access - a standard JUnit base-class idiom, not an
         oversight. allowedAnnotations: fields injected by a framework
         (@Autowired, @TempDir, Testcontainers' @Container, Mockito's @Mock) are
         populated via reflection regardless of declared visibility - the
         annotation, not the modifier, is what makes the field safe. -->
    <module name="VisibilityModifier">
      <property name="protectedAllowed" value="true"/>
      <property name="ignoreAnnotationCanonicalNames"
                value="Autowired, Mock, TempDir, Container, MockitoBean, Value, PersistenceContext"/>
    </module>
    <module name="MethodLength">
      <property name="max" value="150"/>
    </module>
  </module>
  <module name="FileLength">
    <property name="max" value="1200"/>
  </module>
</module>